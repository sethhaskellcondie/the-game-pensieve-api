# Edge reverse proxy for the production stack (see dockerCompose/compose.production.yaml, which bind-mounts
# this file from the repo root as ../Caddyfile). Caddy is the only service with
# public ports; it terminates TLS (automatic HTTPS via Let's Encrypt) and routes each hostname to a private
# backing service on the compose network. The {$VARS} are read from the caddy service's environment.
#
# This file is CHECKED OUT AT THE VERSION TAG on the Droplet — it is not runtime configuration. Changing
# anything here means cutting a release, so it is worth getting right before the first publish.
#
# DNS: point A/AAAA records for APP_DOMAIN, MCP_DOMAIN, and AUTH_DOMAIN at this host before first start so
# Caddy can complete the ACME HTTP/TLS challenge.
{
	email {$ACME_EMAIL}
}

# ---------------------------------------------------------------------------------------------------
# Shared response headers. Caddy adds NONE of these by default — an unconfigured site ships no HSTS, no
# nosniff, no framing policy. Applied to all three hostnames via `import security_headers`.
#
# Delete a line here only if you know what it was protecting against:
#
#   Strict-Transport-Security  Tells the browser to refuse plain HTTP to this host for a year, so an
#                              attacker on the network cannot strip TLS off the FIRST request the way
#                              Caddy's own http->https redirect can be stripped. `preload` is deliberately
#                              omitted: submitting to the browsers' preload list is close to irreversible
#                              and covers subdomains you may not control yet.
#   X-Content-Type-Options     Stops MIME sniffing. Every one of these hosts serves JSON that a browser
#                              could otherwise be talked into treating as HTML, and therefore as script.
#   Referrer-Policy            Keeps the full URL out of the Referer header on cross-origin navigations.
#                              Password-reset and admin-action links carry single-use tokens IN THE URL;
#                              this is what stops one leaking to a third-party site the user clicks to.
#   Content-Security-Policy    frame-ancestors 'none' — clickjacking. It replaces X-Frame-Options, which
#                              is obsolete and which every current browser ignores in its favor. Scoped to
#                              framing ONLY: a full CSP for a Next.js app needs script-src work that is not
#                              a launch-blocker and would silently break the app if guessed at.
#   X-Frame-Options            Belt and braces for anything ancient. Harmless where frame-ancestors wins.
#
# `header` sets these on every response, including errors. -Server strips Caddy's own banner: version
# disclosure is free reconnaissance and costs nothing to remove.
#
# The framing pair lives in its own snippet because the AUTH host must not import it (found on the
# first-deploy bringup, 2026-08-17): the Keycloak admin console frames ITS OWN origin for its
# third-party-cookie check (/realms/master/protocol/openid-connect/3p-cookies/step1.html), and a
# browser receiving both Caddy's `frame-ancestors 'none'` and Keycloak's own `'self'` enforces the
# intersection — 'none' — so the console dies on "Timeout when waiting for 3rd party check iframe
# message." Keycloak stamps its own framing policy (frame-ancestors 'self') on every UI page, so the
# auth host stays clickjacking-protected without Caddy's copy; the app and MCP hosts set no framing
# headers of their own and keep Caddy's.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
(deny_framing) {
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}
}

# The web app (Next.js BFF).
{$APP_DOMAIN} {
	import security_headers
	import deny_framing

	# Body cap at the edge. POST /v1/function/import (reached through this app) binds an arbitrarily large
	# JSON document fully into heap; on a 4 GB box with a 1 GB JVM ceiling, a single large upload is an
	# out-of-memory kill of the backend. Caddy answers 413 without reading the body, so the request never
	# reaches Node or the JVM. The app enforces its own cap too (server.tomcat.max-http-request-header-size
	# / spring.servlet.multipart in the API) — this is the outer of two, not the only one.
	#
	# 10 MB is sized from real data: the largest collection backup in this repo is ~3.3 MB. Raise it if a
	# legitimate import ever 413s, and raise the app-side cap in the same release.
	request_body {
		max_size 10MB
	}

	reverse_proxy frontend:3000
}

# The MCP sidecar. The resource lives at https://{$MCP_DOMAIN}/mcp; the sidecar also serves its
# /.well-known/oauth-protected-resource metadata and /healthz on this host.
{$MCP_DOMAIN} {
	import security_headers
	import deny_framing

	# JSON-RPC tool calls, not uploads. 1 MB is generous for the largest filter payload a tool can send.
	request_body {
		max_size 1MB
	}

	reverse_proxy mcp:3000
}

# Keycloak. Caddy forwards X-Forwarded-* headers by default; the keycloak service trusts them
# (KC_PROXY_HEADERS=xforwarded) and stamps the canonical issuer https://{$AUTH_DOMAIN}/realms/pensieve.
# Deliberately NO `import deny_framing` here — see the snippet's comment. Keycloak sets its own
# frame-ancestors 'self' on every UI page; adding Caddy's 'none' breaks the admin console.
{$AUTH_DOMAIN} {
	import security_headers

	# Login forms and token requests. 1 MB is far more than any of them needs.
	request_body {
		max_size 1MB
	}

	# There is deliberately NO basic-auth gate in front of the admin console — decided 2026-08-18
	# after four rounds of the gate breaking the console in a new way each time (full write-ups in
	# documentation/PastIssues.md: the Bearer/Basic one-Authorization-header collision on the Admin
	# REST API, mid-session popups on background token refreshes whose cancel logged the admin out,
	# and the navigation menu vanishing when the gate swallowed the console's own whoami endpoint).
	# Basic auth fundamentally does not compose with a SPA that sends its own Authorization header.
	#
	# The admin surface is protected by Keycloak itself instead, and REMOVING THE GATE IS ONLY SOUND
	# WHILE ALL THREE OF THESE HOLD (all live as of 2026-08-18):
	#   1. a strong, unique admin password;
	#   2. OTP (2FA) on every account holding the master `admin` role — enforced via the
	#      CONFIGURE_TOTP required action;
	#   3. brute-force detection ENABLED on the MASTER realm (10 failures, temporary lockout — the
	#      pensieve realm bakes the same at import; master defaults to OFF and was flipped by hand:
	#      Realm settings → Security defenses).
	# Keycloak requires a valid admin bearer token on every /admin API call, so the real exposure is
	# the login and token endpoints — which is exactly what 1-3 protect. If any of them is ever
	# undone, revisit this decision rather than resurrecting the gate as it was.

	reverse_proxy keycloak:8080
}

# Rate limiting is deliberately ABSENT. Caddy's `rate_limit` is a third-party plugin, so adding it means
# building and maintaining a custom Caddy image — a change to the edge artifact itself, which is more than
# a launch wants. The partial mitigation in place is the production realm's brute-force protection, which
# is per-ACCOUNT and not per-IP, so it does nothing for volumetric abuse of the anonymous read surface or
# of Keycloak's token endpoint. This is the first item in the post-launch backlog; see the launch plan.
