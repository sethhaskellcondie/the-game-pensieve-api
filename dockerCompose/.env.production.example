# Production environment for compose.production.yaml, which sits next to this file. Copy to `.env` IN THIS
# DIRECTORY (on the Droplet: /opt/pensieve/dockerCompose/.env) and fill in every value.
# NEVER commit the real `.env` — `.gitignore` covers it at this depth, verified with `git check-ignore`.
#
# Compose auto-loads `.env` from the directory holding the compose file, so no flag is needed:
#
#   docker compose -f /opt/pensieve/dockerCompose/compose.production.yaml up -d
#
# If this file is absent, compose does NOT fail — it warns per variable and interpolates blanks, and the
# stack dies on boot. The deploy script asserts its existence rather than relying on that.

# --- Public hostnames (each needs a DNS A/AAAA record pointing at this host, for Caddy's ACME challenge) ---
APP_DOMAIN=pensieve.example.com
MCP_DOMAIN=mcp.example.com
AUTH_DOMAIN=auth.example.com

# --- TLS: Let's Encrypt account email for Caddy automatic HTTPS ---
ACME_EMAIL=you@example.com

# --- Secrets (generate strong, unique values; e.g. `openssl rand -base64 48`) ---
#
# The four below are guarded with `${VAR:?required}` in compose.production.yaml, so leaving any of them
# blank ABORTS `docker compose up` naming the variable, instead of starting a stack that looks healthy
# and is not. Blank is now a hard error, not a warning.
#
# Encrypts the frontend BFF session cookie (iron-session), which carries live Keycloak access AND refresh
# tokens. MUST be >= 32 chars: the frontend refuses to start below that, and refuses to start at all if
# this is unset, rather than falling back to the dev default that is committed to the web repository.
SESSION_SECRET=
# Becomes the pensieve-web confidential client's secret: Keycloak resolves it into the realm import
# (keycloak/import-prod/pensieve-realm.json) via the PENSIEVE_WEB_CLIENT_SECRET placeholder on first boot.
OIDC_CLIENT_SECRET=
# App database (Postgres) password.
POSTGRES_PASSWORD=
# Keycloak database (separate Postgres) password.
KC_DB_PASSWORD=
# Keycloak bootstrap admin. These apply ONLY on the very first boot with an empty keycloak-db; changing
# them later does nothing. After the first deploy, create a real admin account (with OTP), delete this
# bootstrap one, and blank these two values.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# --- Basic-auth gate in front of Keycloak's admin console (Caddyfile) ---
# A second credential in front of /admin and /realms/master, separate from the Keycloak admin password
# above. Generate the hash with:  docker run --rm caddy:2 caddy hash-password --plaintext 'yourpassword'
# SINGLE-QUOTE the hash below — bcrypt hashes contain $ signs.
KC_ADMIN_UI_USER=seth
KC_ADMIN_UI_PASSWORD_HASH='$2a$14$replace.me.with.a.real.bcrypt.hash'

# --- SMTP relay (required: Keycloak sends the password-reset and execute-actions messages) ---
# ONE-SHOT: Keycloak resolves every SMTP_* value into the production realm import via the PENSIEVE_SMTP_*
# placeholders on FIRST BOOT ONLY. After that the realm is a live database and this file is no longer
# consulted for them — a later change means editing Realm Settings -> Email in the admin console by hand,
# at which point this file and the running realm disagree. Get SMTP_FROM right the first time.
#
# The relay is Resend (chosen for deliverability: a fresh Droplet IP has no sending reputation, and
# registrationAllowed=false makes self-service password reset the only credential-recovery path, so a
# message in a spam folder is a permanently locked-out user). Keycloak speaks SMTP only and cannot use
# an HTTP send API, so the Resend API key is used AS the SMTP password. A sending-access-only key is
# sufficient and is what should be issued.
#
# STARTTLS and SSL are a PAIR chosen by port, never mixed:
#   465 -> STARTTLS=false, SSL=true   (implicit TLS -- what this deployment uses)
#   587 -> STARTTLS=true,  SSL=false  (explicit TLS)
# Mixing them fails at connect time with a TLS handshake error that never names the port as the cause.
# Resend listens on 25/465/587/2465/2587 at once, so the port is purely a client-side choice.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
# The From/Reply-To/envelope-From address on every message. Must be on the domain verified with Resend
# (whatever you verified dictates what you may send as), or the relay rejects the send. The realm also
# sets replyTo and envelopeFrom to this value, so replies land here.
SMTP_FROM=no-reply@pensieve.example.com
# Literally the string "resend" -- this is not your account email.
SMTP_USER=resend
# The Resend API key (re_...). Treat it as a password; it belongs in the password manager, not in git.
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=true

# --- Fixed in compose, not set here (FYI) ---
#   PENSIEVE_ENV=production  is hardcoded on the backend service in compose.production.yaml, deliberately
#   NOT read from this file. It declares the deployment production, and the backend refuses to start if it
#   is set while the `secured` profile is missing from SPRING_PROFILES_ACTIVE — without `secured` the app
#   permits every request and disables every role check, and it boots green while doing so. Keeping the
#   marker out of `.env` and out of the profile list is the point: the slip that drops `secured` cannot
#   also disarm the guard that catches it. Do not move it here, and do not set it on an unsecured stack.

# --- Derived values (FYI — the compose file builds these from the vars above, and Keycloak resolves them
#     into the production realm import (keycloak/import-prod/pensieve-realm.json) on first boot. After the
#     first deploy, verify a decoded token matches — see the header of compose.production.yaml):
#       OIDC / token issuer : https://${AUTH_DOMAIN}/realms/pensieve
#       MCP resource (aud)  : https://${MCP_DOMAIN}/mcp
#       Web login callback  : https://${APP_DOMAIN}/api/auth/callback
#       Web public origin   : https://${APP_DOMAIN}  (passed to the frontend as APP_ORIGIN — behind the
#                             proxy it cannot infer this itself; without it every login is rejected)
